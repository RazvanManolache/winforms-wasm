@using WfWasm.Shim
@inject SceneState State
@implements IDisposable

<a class="workspace-brand" href="/"><span class="brand-mark">w<span>f</span></span><span>App Studio<small>WINFORMS IN YOUR BROWSER</small></span></a>
<div class="library-heading"><span class="eyebrow">YOUR LIBRARY</span><span class="count-badge">@State.Entries.Count</span></div>
<div class="search-box"><span aria-hidden="true">⌕</span><input aria-label="Search apps" placeholder="Search apps…" @bind="_filter" @bind:event="oninput" />
    @if (_filter.Length > 0) { <button aria-label="Clear search" @onclick="() => _filter = string.Empty">×</button> }
</div>
<div class="library-tabs" aria-label="Filter app library">
    @foreach (var group in new[] { "All apps", "Everyday", "Telerik" })
    {
        <button class="@(_group == group ? "selected" : "")" aria-pressed="@(_group == group)" @onclick="() => _group = group">@group</button>
    }
</div>
<nav class="app-list" aria-label="Apps">
    @foreach (var category in new[] { "Everyday apps", "Telerik demos" })
    {
        var entries = Filtered.Where(e => Category(e) == category).ToList();
        if (entries.Count == 0) { continue; }
        <div class="app-group-heading">@category <span>@entries.Count</span></div>
        @foreach (var entry in entries)
        {
            <button class="app-item @(State.Current == entry.Scene ? "active" : "")" aria-current="@(State.Current == entry.Scene ? "page" : null)" @onclick="() => State.Select(entry.Scene)">
                <span class="app-icon @IconClass(entry)">@Icon(entry)</span><span class="app-item-copy"><strong>@Name(entry)</strong><small>@Description(entry)</small></span><span class="app-arrow">›</span>
            </button>
        }
    }
    @if (!Filtered.Any()) { <div class="empty-library"><strong>No apps found</strong><p>Try another name or category.</p><button class="subtle-button" @onclick="Reset">Reset filters</button></div> }
</nav>
<div class="sidebar-note"><span class="status-dot"></span><div>Runs locally in your browser<small>Select an app to get started.</small></div></div>

@code {
    private string _filter = "";
    private string _group = "All apps";
    private IEnumerable<SceneState.SceneEntry> Filtered => State.Entries.Where(e =>
        (_group == "All apps" || (_group == "Telerik") == IsTelerik(e)) &&
        _filter.Split(' ', StringSplitOptions.RemoveEmptyEntries).All(word =>
            (e.Label + " " + Description(e) + " " + e.SourceLabel).Contains(word, StringComparison.OrdinalIgnoreCase)));
    private static bool IsTelerik(SceneState.SceneEntry e) => e.AppFolder?.StartsWith("telerik-", StringComparison.Ordinal) == true;
    private static string Category(SceneState.SceneEntry e) => IsTelerik(e) ? "Telerik demos" : "Everyday apps";
    private static string Name(SceneState.SceneEntry e) => e.Label.Replace("Telerik: ", "");
    private static string IconClass(SceneState.SceneEntry e) => IsTelerik(e) ? "teal" : e.Scene == AppScene.Paint ? "violet" : "blue";
    private static string Icon(SceneState.SceneEntry e) => e.Scene switch { AppScene.Smoke => "▣", AppScene.Calendar => "▦", AppScene.Paint => "◒", AppScene.Calculator => "＋", AppScene.Todo => "✓", AppScene.TicTacToe => "#", AppScene.TelerikPhoto => "▧", AppScene.TelerikBookshelf => "▤", _ => Name(e)[..1] };
    private static string Description(SceneState.SceneEntry e) => e.Scene switch {
        AppScene.Smoke => "Start here · basic controls", AppScene.Calendar => "Dates & schedules", AppScene.Paint => "Image editing & effects",
        AppScene.Calculator => "Numbers & operations", AppScene.Todo => "Tasks & checklists", AppScene.TicTacToe => "A classic board game",
        AppScene.TelerikPhoto => "Photos & drag interactions", AppScene.TelerikBookshelf => "Books & data browsing", _ => "WinForms component demo" };
    private void Reset() { _filter = ""; _group = "All apps"; }
    protected override void OnInitialized() => State.Changed += OnStateChanged;
    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= OnStateChanged;
}