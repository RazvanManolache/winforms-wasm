@inherits LayoutComponentBase
@inject SceneState State
@inject IJSRuntime JS
@implements IDisposable

<div class="preview-shell @(_menuOpen ? "menu-open" : "")">
    <aside class="app-sidebar"><NavMenu /></aside>
    <main class="preview-main">
        <div class="workspace-toolbar">
            <span class="toolbar-title"><i class="live-dot" aria-hidden="true"></i><h1>@State.CurrentEntry.Label.Replace("Telerik: ", "")</h1></span><span class="source-label">@State.CurrentEntry.SourceLabel</span>
            @if (State.CurrentEntry.SourceUrl is string url) { <a href="@url" target="_blank" rel="noopener">View source ↗</a> }
        </div>
        <article class="preview-content">@Body</article>
        <footer class="workspace-footer">
            <span>WinForms · WebAssembly</span>
            <div class="foot-metrics" aria-label="Loading measurements">
                <span class="foot-metric"><span>APP LOAD</span><strong id="metric-load">—</strong><small id="metric-phase">Starting</small></span>
                <span class="foot-metric"><span>APP DATA</span><strong id="metric-data">0.00 MB</strong><small id="metric-files">0 files</small></span>
                <span class="foot-metric" title="Measured HTTP transfer size for this selection, including response headers. Browser cache hits transfer no body."><span>NETWORK</span><strong id="metric-network">0.00 MB</strong><small id="metric-network-detail">Measured transfer</small></span>
                <span class="foot-metric" title="HTTP cache hits and in-session data reuse are counted separately."><span>CACHE REUSE</span><strong id="metric-cache">0 files</strong><small id="metric-cache-detail">Waiting for resources</small></span>
                <span class="foot-metric" title="Navigation to workspace; uncompressed runtime and shell resources loaded before the app selection."><span>RUNTIME BOOT</span><strong id="metric-boot">—</strong><small id="metric-boot-detail">Navigation → workspace</small></span>
            </div>
            <a href="/errors" target="_blank" rel="noopener">Error inventory ↗</a>
        </footer>
    </main>
    <aside class="app-rail" aria-label="Workspace actions">
        <a class="rail-brand" href="/" title="App Studio home" aria-label="App Studio home"><span class="brand-mark">w<span>f</span></span></a>
        <button class="icon-button rail-button menu-toggle" title="Toggle app library" aria-label="Toggle app menu" aria-expanded="@_menuOpen" @onclick="() => _menuOpen = !_menuOpen">☰</button>
        <button id="runtime-reference-toggle" class="icon-button rail-button @(State.ShowDesktopReference ? "selected" : "")" title="Compare with desktop screenshot" aria-label="Compare desktop" aria-pressed="@State.ShowDesktopReference" @onclick="State.ToggleDesktopReference">◫</button>
        <button class="icon-button rail-button" title="Reload app" aria-label="Reload" @onclick="Reload">↻</button>
        <a class="icon-button rail-button" title="Evaluation dashboard" aria-label="Evaluation dashboard" href="/dashboard">▤</a>
    </aside>
</div>

@code {
    private bool _menuOpen;
    protected override void OnInitialized() => State.Changed += OnStateChanged;
    private void OnStateChanged() { _menuOpen = false; _ = InvokeAsync(StateHasChanged); }
    private Task Reload() => JS.InvokeVoidAsync("preview.reload").AsTask();
    public void Dispose() => State.Changed -= OnStateChanged;
}
